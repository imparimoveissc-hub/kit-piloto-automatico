      "mcp__54228a22-0b79-4b37-8897-511ba5af834c__COMPOSIO_SEARCH_TOOLS",
      "mcp__54228a22-0b79-4b37-8897-511ba5af834c__COMPOSIO_REMOTE_BASH_TOOL",
