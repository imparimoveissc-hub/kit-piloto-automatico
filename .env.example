# ────────────────────────────────────────────────────────────────────
# Kit Piloto Automático V30 — .env.example (TEMPLATE, sem segredos)
# ────────────────────────────────────────────────────────────────────
# Como usar:
#   1. cp .env.example .env       (Windows: copy .env.example .env)
#   2. Preencha SOMENTE no .env (não no .example).
#   3. Confirme que ".env" está no .gitignore (já está).
#   4. NUNCA cole valores reais aqui — esse arquivo é commitado.
#
# Regras de ouro:
# - Nenhum token nessa pasta. Tokens vivem só no .env local OU no
#   ~/.profile do WSL/macOS (carregados como variável de ambiente).
# - Em caso de vazamento acidental: revogue o token no Meta Business
#   Manager IMEDIATAMENTE antes de qualquer outra coisa.
# ────────────────────────────────────────────────────────────────────


# ── Meta Marketing API (Ads CLI) ─────────────────────────────────────
# System User Token gerado em: Business Manager → Configurações
#   → Usuários do Sistema → seu System User → Gerar token
# Permissões mínimas: ads_management, ads_read, business_management
META_ACCESS_TOKEN=

# Conta de anúncios padrão (a CLI usa essa por default)
# Formato: act_ + 15 dígitos. Pode encontrar em Gerenciador → URL.
META_DEFAULT_AD_ACCOUNT=act_XXXXXXXXXXXXXXX

# Business Manager ID (opcional — usado por relatórios multi-conta)
META_BUSINESS_ID=

# Pixel ID (opcional — usado por @attribution-auditor)
META_PIXEL_ID=

# App ID + App Secret (apenas se for usar Graph API direto fora da CLI)
# A CLI oficial NÃO precisa disso quando usa System User Token.
META_APP_ID=
META_APP_SECRET=


# ── Outras integrações (preencher conforme necessário) ───────────────
# Hubla / Hotmart / Eduzz / Ticto — webhooks de checkout
HUBLA_API_KEY=
HOTMART_HOTTOK=
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=

# Google Ads (se usar a stack pra Google também)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# OpenAI / Anthropic (se rodar agentes externos ao Claude Code)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── Configuração local do operador ───────────────────────────────────
# Nome curto pra aparecer em prompts e relatórios
OPERATOR_NAME=
OPERATOR_BRAND=

# Path do wrapper meta.cmd no Windows (preenchido pelo /meta-cli-install)
META_CLI_WRAPPER_PATH=
