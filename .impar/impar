${BLUE}Versão:${NC} $VERSION
${BLUE}Projeto:${NC} Kit Piloto Automático V30
${BLUE}Modo:${NC} Somente leitura + Backup seguro

${BLUE}SINTAXE${NC}
  impar <comando> [opções]

${BLUE}COMANDOS DISPONÍVEIS${NC}

${BLUE}• Gerenciamento${NC}
  ${GREEN}help${NC}                Mostrar esta ajuda
  ${GREEN}discover${NC}            Descobrir e registrar automações
  ${GREEN}list${NC}                Listar automações registradas

${BLUE}• Consulta (somente leitura)${NC}
