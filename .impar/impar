#!/bin/bash

# impar - Central entry point for Impar Imóveis Automation

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULES_DIR="$SCRIPT_DIR/modules"
LIB_DIR="$SCRIPT_DIR/lib"

source "$LIB_DIR/common.sh"

VERSION="1.0.0"
PROJECT_ROOT="$(get_project_root)"

main() {
  local command="${1:-help}"

  case "$command" in
    help)
      show_help
      ;;
    status)
      exec "$MODULES_DIR/status.sh" "${@:2}"
      ;;
    doctor)
      exec "$MODULES_DIR/doctor.sh" "${@:2}"
      ;;
    logs)
      exec "$MODULES_DIR/logs.sh" "${@:2}"
      ;;
    memory)
      exec "$MODULES_DIR/memory.sh" "${@:2}"
      ;;
    backup)
      exec "$MODULES_DIR/backup.sh" "${@:2}"
      ;;
    discover)
      exec "$MODULES_DIR/discover.sh" "${@:2}"
      ;;
    list)
      exec "$MODULES_DIR/list.sh" "${@:2}"
      ;;
    info)
      exec "$MODULES_DIR/info.sh" "${@:2}"
      ;;
    open)
      exec "$MODULES_DIR/open.sh" "${@:2}"
      ;;
    run)
      exec "$MODULES_DIR/run.sh" "${@:2}"
      ;;
    health)
      exec "$MODULES_DIR/health.sh" "${@:2}"
      ;;
    map)
      exec "$MODULES_DIR/map.sh" "${@:2}"
      ;;
    version)
      show_version
      ;;
    --version|-v)
      show_version
      ;;
    *)
      print_error "Comando desconhecido: $command"
      echo ""
      show_help
      exit 1
      ;;
  esac
}

