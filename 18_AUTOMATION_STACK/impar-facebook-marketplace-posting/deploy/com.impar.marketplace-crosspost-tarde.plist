<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.impar.marketplace-crosspost-tarde</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>PLACEHOLDER_SCRIPT_PATH/run_crosspost.sh</string>
		<string>--cadence</string>
		<string>180</string>
		<string>--max-dia</string>
		<string>64</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>17</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/usuario/Library/Logs/impar-crosspost-tarde.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/usuario/Library/Logs/impar-crosspost-tarde-error.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/usuario</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
