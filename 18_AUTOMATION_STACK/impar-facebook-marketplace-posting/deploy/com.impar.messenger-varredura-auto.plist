<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.impar.messenger-varredura-auto</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/usuario/.local/impar-automation/messenger/varredura_inbox.py</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/usuario/Library/Logs/impar-varredura-auto.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/usuario/Library/Logs/impar-varredura-auto-error.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
