IMPAR_WHATSAPP_NUMBER=5547920026017
JONATA_ALERT_WHATSAPP_NUMBER=554796876631

# Mantem o servico privado na VPS. Use Caddy/Nginx/Cloudflare Tunnel na frente.
MESSENGER_BRIDGE_BIND_HOST=127.0.0.1
MESSENGER_BRIDGE_PORT=8791

# Comece sempre em true. Troque para false so depois de validar webhooks reais.
MESSENGER_BRIDGE_DRY_RUN=true

# Webhook que envia WhatsApp pela conta oficial da Impar ou pelo orquestrador aprovado.
WHATSAPP_SEND_WEBHOOK_URL=
WHATSAPP_SEND_TOKEN=

# Webhook que envia resposta real no Messenger por canal aprovado.
MESSENGER_SEND_WEBHOOK_URL=
MESSENGER_SEND_TOKEN=

# Opcional: sobrescrever caminho do master prompt.
IMPAR_MASTER_PROMPT_PATH=/opt/impar/kpa30/05_WORKSPACE/clientes/impar-imoveis/whatsapp/master-prompt-papo-ai.txt
