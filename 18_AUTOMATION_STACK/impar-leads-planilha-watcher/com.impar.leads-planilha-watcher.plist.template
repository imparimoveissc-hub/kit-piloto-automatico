<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.impar.leads-planilha-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>HOME_PLACEHOLDER/.local/impar-automation/leads-planilha/leads_watcher.py</string>
    </array>

    <!-- Roda a cada 5 min; sai em <50ms se não houver lead novo (0 tokens) -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>HOME_PLACEHOLDER/.local/impar-automation/leads-planilha/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_PLACEHOLDER/.local/impar-automation/leads-planilha/watcher.log</string>
</dict>
</plist>
