# ── Asaas ──────────────────────────────────────────────────────────────────────
# Chave de API do Asaas (começa com $aact_...)
ASAAS_API_KEY=

# Token secreto configurado no webhook do Asaas (para validar autenticidade)
ASAAS_WEBHOOK_TOKEN=

# Ambiente: "production" ou "sandbox"
ASAAS_ENV=production

# ── Portal de Emissão ──────────────────────────────────────────────────────────
# Qual portal usar: "nacional" (padrão, novo) ou "joinville" (legado, será descontinuado em 20/07/2026)
PORTAL_TIPO=nacional

# ── Portal Nacional NFS-e (novo) ──────────────────────────────────────────────
# Usuário e senha para acesso ao Portal Nacional da NFS-e
# Se não configurado, usa os mesmos valores de NFEM_USER/NFEM_PASSWORD (fallback)
NFSE_NACIONAL_USER=
NFSE_NACIONAL_PASSWORD=

# Certificado digital A1 para emissão 100% automática no Portal Nacional
NFSE_CERT_PFX_PATH=config/certs/impar_50886299000100.pfx
NFSE_CERT_PASSWORD=

# ── NF-em Joinville (legado, será descontinuado) ───────────────────────────────
NFEM_USER=
NFEM_PASSWORD=

# ── Caminhos ───────────────────────────────────────────────────────────────────
# Pasta raiz para salvar as notas fiscais em PDF
NOTAS_BASE_DIR=/Users/user/Desktop/backup Jonata/contabilidade Impar imóveis/notas fiscais

# ── Servidor webhook ───────────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8765

# ── Modo de operação ───────────────────────────────────────────────────────────
# "true" = preenche o formulário mas NÃO confirma a emissão (teste)
DRY_RUN=true

# ── Playwright ─────────────────────────────────────────────────────────────────
# O portal pode exigir captcha/autenticação no login.
# Com certificado digital A1 ou sessão quente válida, a emissão roda headless.
BROWSER_HEADLESS=false
