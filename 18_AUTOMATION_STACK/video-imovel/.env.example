# IMPAR STUDIO — Variáveis de ambiente
# Copie para .env e preencha

# PORT do servidor Flask (padrão: 5001)
PORT=5001

# Replicate API Token — necessário para Image Studio gerar imagens automaticamente
# Obtenha em: https://replicate.com/account/api-tokens
# Sem este token, o Image Studio gera prompts prontos para uso em Midjourney/Leonardo
REPLICATE_API_TOKEN=
